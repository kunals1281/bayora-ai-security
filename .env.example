# Bayora Backend Server Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Optional: OpenAI LLM Judge Configuration (Local deterministic evaluator is used by default)
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-4o-mini

# ==============================================================
# Target LLM Adapter & Inference Gateway Configuration
# ==============================================================
# Provider: "ollama" (local Qwen), "openai" (vLLM/OpenAI API), or "mock" (offline fallback)
TARGET_LLM_PROVIDER=ollama
TARGET_LLM_ENDPOINT=http://target:11434
TARGET_LLM_MODEL=qwen2.5:3b
TARGET_LLM_API_KEY=

# Inference Gateway Security & Authorization
GATEWAY_API_KEY=generate_at_startup_or_set_secret_key
GATEWAY_ALLOWED_KEYS=

# Rate Limiting (Requests per Window)
GATEWAY_RATE_LIMIT_MAX=10
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Database Persistence
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./data/bayora.sqlite