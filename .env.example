# OOSC / Bayora Backend Server Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Optional: OpenAI LLM Judge Configuration (Local heuristic evaluator is used if key is not provided)
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-4o-mini

# ==============================================================
# P1: Target LLM Adapter & Inference Gateway Configuration
# ==============================================================
# Provider: "mock" (default, zero-dep test), "ollama" (local Qwen/Ollama), or "openai" (vLLM/OpenAI)
TARGET_LLM_PROVIDER=mock
TARGET_LLM_ENDPOINT=http://localhost:11434
TARGET_LLM_MODEL=qwen2.5:7b
TARGET_LLM_API_KEY=

# Inference Gateway Security & Authorization
GATEWAY_API_KEY=sk-bayora-target-gateway-key-2026
GATEWAY_ALLOWED_KEYS=bayora_red_token_secret,bayora_blue_token_secret,bayora_admin_token_secret

# Rate Limiting (Requests per Window)
GATEWAY_RATE_LIMIT_MAX=10
GATEWAY_RATE_LIMIT_WINDOW_MS=60000